# Node.js 24+ is required. Copy this file to .env.local before first launch.
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/arima.sqlite
# Imported exactly once into a new database. The source file stays unchanged.
LEGACY_DATA_PATH=./data-arima-db.json
# Used only when creating the initial administrator account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-password
SESSION_HOURS=24
# false for local HTTP; true behind production HTTPS.
COOKIE_SECURE=false

# Vercel: connect a PostgreSQL database (e.g. Neon) in Project > Storage.
# Set DATABASE_URL and ADMIN_PASSWORD in Vercel Environment Variables.
# Never use the local SQLite file as production storage on Vercel.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
